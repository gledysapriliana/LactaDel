rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Keamanan dokumen pengguna
    match /users/{userId} {
      // Pengguna hanya dapat membaca dan mengubah profilnya sendiri
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subkoleksi: Catatan Menyusui
      match /catatan_menyusui/{catatanId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Subkoleksi: Pengaturan (Pengingat, Notifikasi, dsb)
      match /pengaturan/{pengaturanId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Tolak semua akses ke dokumen lain secara default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
